{
  "name": "vscode-tools",
  "publisher": "FTRhak",
  "displayName": "vscode-tools",
  "description": "",
  "icon": "src/assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FTRhak/vscode-tools"
  },
  "homepage": "https://github.com/FTRhak/vscode-tools",
  "bugs": {
    "url": "https://github.com/FTRhak/vscode-tools/issues"
  },
  "license": "MIT",
  "keywords": [
    "vscode",
    "tools",
    "fonts",
    "angular",
    "react",
    "schematics"
  ],
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-tools.fonts.openFontPreview",
        "title": "Open Font"
      },
      {
        "command": "vscode-react.createReactComponent",
        "title": "Generate Component"
      },
      {
        "command": "vscode-angular.createAngularApplication",
        "title": "Generate Application"
      },
      {
        "command": "vscode-angular.createAngularClass",
        "title": "Generate Class"
      },
      {
        "command": "vscode-angular.createAngularComponent",
        "title": "Generate Component"
      },
      {
        "command": "vscode-angular.createAngularConfig",
        "title": "Generate Config"
      },
      {
        "command": "vscode-angular.createAngularDirective",
        "title": "Generate Directive"
      },
      {
        "command": "vscode-angular.createAngularEnvironment",
        "title": "Generate Environments"
      },
      {
        "command": "vscode-angular.createAngularGuard",
        "title": "Generate Guard"
      },
      {
        "command": "vscode-angular.createAngularInterceptor",
        "title": "Generate Interceptor"
      },
      {
        "command": "vscode-angular.createAngularLibrary",
        "title": "Generate Library"
      },
      {
        "command": "vscode-angular.createAngularModule",
        "title": "Generate Module"
      },
      {
        "command": "vscode-angular.createAngularPipe",
        "title": "Generate Pipe"
      },
      {
        "command": "vscode-angular.createAngularResolver",
        "title": "Generate Resolver"
      },
      {
        "command": "vscode-angular.createAngularService",
        "title": "Generate Service"
      },
      {
        "command": "vscode-angular.createAngularServiceWorker",
        "title": "Generate Service Worker"
      },
      {
        "command": "vscode-angular.createAngularWebWorker",
        "title": "Generate Web Worker"
      }
    ],
    "submenus": [
      {
        "id": "schematicsSubmenu",
        "label": "Schematics Tools"
      },
      {
        "id": "schematicsAngularSubmenu",
        "label": "Angular"
      },
      {
        "id": "schematicsReactSubmenu",
        "label": "React"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscode-tools.fonts.openFontPreview",
          "group": "navigation",
          "when": "resourceExtname == .woff || resourceExtname == .woff2 || resourceExtname == .ttf || resourceExtname == .otf || resourceExtname == .eot"
        },
        {
          "submenu": "schematicsSubmenu",
          "group": "navigation"
        }
      ],
      "schematicsSubmenu": [
        {
          "submenu": "schematicsAngularSubmenu",
          "group": "schematics"
        },
        {
          "submenu": "schematicsReactSubmenu",
          "group": "schematics"
        }
      ],
      "schematicsAngularSubmenu": [
        {
          "command": "vscode-angular.createAngularApplication",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularClass",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularComponent",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularConfig",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularDirective",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularEnvironment",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularGuard",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularInterceptor",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularLibrary",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularModule",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularPipe",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularResolver",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularService",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularServiceWorker",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularWebWorker",
          "group": "angular"
        }
      ],
      "schematicsReactSubmenu": [
        {
          "command": "vscode-react.createReactComponent",
          "group": "react"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsix": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  }
}
