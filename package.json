{
  "name": "vscode-tools",
  "publisher": "FTRhak",
  "displayName": "vscode-tools",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-angular.openFileInfo",
        "title": "__Open File Info__"
      },
      {
        "command": "vscode-angular.openInTerminal",
        "title": "__Open in Terminal__"
      },
      {
        "command": "vscode-angular.createAngularApplication",
        "title": "Generate Application"
      },
      {
        "command": "vscode-angular.createAngularClass",
        "title": "Generate Class"
      },
      {
        "command": "vscode-angular.createAngularComponent",
        "title": "Generate Component"
      },
      {
        "command": "vscode-angular.createAngularConfig",
        "title": "Generate Config"
      },
      {
        "command": "vscode-angular.createAngularDirective",
        "title": "Generate Directive"
      },
      {
        "command": "vscode-angular.createAngularEnvironment",
        "title": "Generate Environments"
      },
      {
        "command": "vscode-angular.createAngularInterceptor",
        "title": "Generate Interceptor"
      },
      {
        "command": "vscode-angular.createAngularLibrary",
        "title": "Generate Library"
      },
      {
        "command": "vscode-angular.createAngularModule",
        "title": "Generate Module"
      },
      {
        "command": "vscode-angular.createAngularPipe",
        "title": "Generate Pipe"
      },
      {
        "command": "vscode-angular.createAngularService",
        "title": "Generate Service"
      }
    ],
    "submenus": [
      {
        "id": "schematicsSubmenu",
        "label": "Schematics Tools"
      },
      {
        "id": "schematicsAngularSubmenu",
        "label": "Angular"
      },
      {
        "id": "schematicsReactSubmenu",
        "label": "React"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "schematicsSubmenu",
          "group": "navigation"
        }
      ],
      "schematicsSubmenu": [
        {
          "submenu": "schematicsAngularSubmenu",
          "group": "schematics"
        },
        {
          "submenu": "schematicsReactSubmenu",
          "group": "schematics"
        }
      ],
      "schematicsAngularSubmenu": [
        {
          "command": "vscode-angular.createAngularApplication",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularClass",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularComponent",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularConfig",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularDirective",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularEnvironment",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularInterceptor",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularLibrary",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularModule",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularPipe",
          "group": "angular"
        },
        {
          "command": "vscode-angular.createAngularService",
          "group": "angular"
        }
      ],
      "schematicsReactSubmenu": [
        {
          "command": "vscode-angular.openFileInfo",
          "group": "react"
        },
        {
          "command": "vscode-angular.openInTerminal",
          "group": "react"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  }
}
